#!/usr/bin/env python3
"""UserPromptSubmit: si el prompt nombra un servidor o un área de los que ya
han mordido (pixel-vps, gstd, cert-manager, k8s…), le pone delante al agente
los títulos de esos incidentes, una vez por sesión cada uno. Y si nombra una
tarea en curso del espacio del repo —por su ref (`proteus-7`) o por una clave
de fuera de su descripción (`PROTEUS-224`)—, su «dónde quedó».

Es lo que hace que cac sea memoria en el punto de acción y no sólo cuando
alguien se acuerda de buscar: los dieciséis tropiezos del simulacro de gstd
(command-and-control-283) quedaron en el hilo de una tarea, y quien fuera a
tocar pixel-vps no los iba a encontrar sin saber que estaban ahí
(command-and-control-289, decidido con jose el 2-nov-2026).

Determinista y barato a propósito: sin modelo y sin buscar por significado.
El vocabulario son los nombres de servidores y áreas que **tienen** incidentes
en la org del repo, se pide a cac una vez cada `VOCAB_TTL` segundos y se
compara en local. Lo que imprime entra en el contexto; si no casa nada, no
imprime nada. Ante cualquier fallo, calla.

Un área es una palabra que alguien escribió al apuntar el incidente, y muchas
son prosa («red», «agente», «pruebas»): el 11-nov-2026, en una sesión sobre el
propio cac, salieron cuatro veces hasta 8 incidentes ajenos, dos de ellas por
el aviso de un subagente (incidente 60919704). Desde entonces:
- un servidor nombrado trae lo abierto y lo arreglado: antes de tocar gstd,
  todo lo que mordió en gstd sirve;
- un área trae sólo lo abierto, salvo que sea **rara** en la org (la llevan
  `RARE_AREA` incidentes o menos): «cert-manager» sí, «k8s» no;
- las áreas que son prosa (`PROSE`) no casan nunca;
- los avisos del sistema (`<task-notification>`, `<system-reminder>`) que
  llegan pegados al prompt no se leen: no los escribió nadie;
- lo que casó y no cupo se da por visto, para no volver a salir en cada
  prompt.
"""
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from cac_hooks import (  # noqa: E402
    cac_config,
    fold,
    in_progress,
    incidents,
    load_seen,
    read_input,
    report_shown,
    repo_of,
    repo_org,
    save_seen,
    shadowed,
)

MAX_LINES = 8
# Un nombre de dos letras («ui», «db») casaría con medio idioma.
MIN_TERM = 3
# Un área que llevan más incidentes que estos es general («k8s»): sólo trae
# lo abierto.
RARE_AREA = 2
# Áreas que son palabras de todos los días: con ellas, cualquier frase casa.
PROSE = frozenset({
    "red", "agente", "agentes", "prompt", "pruebas", "fechas", "ramas", "usuarios", "seguridad",
    "convenciones", "dominios", "listados", "saldos", "notificaciones", "datos", "migracion",
    "contabilidad", "faltantes", "app", "api", "backend", "database", "auth",
})
# Lo que el sistema pega al prompt (el resultado de un subagente, un recordatorio).
SYSTEM_BLOCK = re.compile(r"<(task-notification|system-reminder)>.*?(</\1>|$)", re.S)


def own_words(prompt):
    """El prompt sin los avisos del sistema que vienen pegados."""
    return SYSTEM_BLOCK.sub(" ", prompt)


def server_terms(inc):
    return {fold(s.get("name", "")) for s in inc.get("servers") or [] if len(s.get("name", "")) >= MIN_TERM}


def area_terms(inc):
    return {fold(a) for a in inc.get("areas") or [] if len(a) >= MIN_TERM and fold(a) not in PROSE}


def area_counts(found):
    counts = {}
    for inc in found:
        for a in area_terms(inc):
            counts[a] = counts.get(a, 0) + 1
    return counts


def terms_of(inc, counts):
    """Los nombres por los que el prompt trae este incidente: sus servidores
    siempre; sus áreas si está abierto, o si son raras en la org."""
    out = server_terms(inc)
    is_open = inc.get("status") == "open"
    out |= {a for a in area_terms(inc) if is_open or counts.get(a, 0) <= RARE_AREA}
    return out


def named(prompt, term):
    """Si el prompt nombra el término como palabra entera: «gstd» sí casa en
    «en gstd falla», no en «gstdx»; «cert-manager» casa tal cual."""
    return re.search(r"(?<![a-z0-9])" + re.escape(term) + r"(?![a-z0-9])", prompt) is not None


def lines_for(prompt, found, seen):
    prompt = fold(prompt)
    counts = area_counts(found)
    hits, words = [], []
    for inc in found:
        if inc.get("id") in seen:
            continue
        matched = sorted(t for t in terms_of(inc, counts) if named(prompt, t))
        if not matched:
            continue
        hits.append(inc)
        words.extend(w for w in matched if w not in words)
    if not hits:
        return [], []
    out = [f"cac · lo que ya mordió en lo que nombras ({', '.join(words)}):"]
    for inc in hits[:MAX_LINES]:
        state = "abierto" if inc.get("status") == "open" else "arreglado"
        where = ", ".join([s.get("name", "") for s in inc.get("servers") or []] + list(inc.get("areas") or []))
        out.append(f"- [{state}] {inc.get('title', '')} ({where}) · get_incident {inc.get('id')}")
    if len(hits) > MAX_LINES:
        out.append(f"… y {len(hits) - MAX_LINES} más: list_incidents con server o area.")
    return out, [i.get("id") for i in hits]


def names_ref(prompt, ref):
    """Si el prompt nombra la referencia tal cual se escribe. Distingue
    mayúsculas a propósito: `proteus-7` es la tarea 7 de cac y `PROTEUS-7`
    el ticket 7 de Jira, que numera por su lado."""
    return re.search(r"(?<![A-Za-z0-9-])" + re.escape(ref) + r"(?![0-9])", prompt) is not None


def task_lines_for(prompt, tasks, seen):
    """Las tareas en curso que el prompt nombra por su ref de cac o por una
    clave de fuera de su descripción, con su «dónde quedó». Así no hace falta
    que el agente se acuerde de buscar: jose preguntaba «¿en cac buscaste
    algo?» llevando una hora con la tarea del agente A (5-nov-2026,
    command-and-control-319)."""
    out, shown = [], []
    for t in tasks:
        key = "task:" + str(t.get("id"))
        if key in seen:
            continue
        ref = t.get("ref") or ""
        named = [ref] if ref and names_ref(prompt, ref) else []
        named += [k for k in t.get("keys") or [] if names_ref(prompt, k)]
        if not named:
            continue
        line = f"- {ref} «{t.get('title', '')}»"
        if named[0] != ref:
            line = f"- {named[0]} → {ref} «{t.get('title', '')}»"
        if t.get("handoff"):
            first = t["handoff"].strip().splitlines()[0]
            line += f" · dónde quedó: {first} ({t.get('handoffBy', '')}, {(t.get('handoffAt') or '')[:10]})"
        else:
            line += " · sin «dónde quedó»"
        out.append(line + f" · get_task {ref}")
        shown.append((key, ref))
        if len(out) == MAX_LINES:
            break
    if out:
        out.insert(0, "cac · la tarea que nombras, en curso:")
    return out, [k for k, _ in shown], [r for _, r in shown]


def main():
    inp = read_input()
    prompt = own_words(inp.get("prompt") or "")
    if not prompt.strip() or shadowed(inp):
        return
    cfg = cac_config()
    if not cfg:
        return
    session = inp.get("session_id") or ""
    seen = load_seen(session)
    out, shown, targets = [], [], []
    _, repo = repo_of(inp.get("cwd") or os.getcwd())
    tasks = in_progress(cfg, repo)
    if tasks:
        lines, ids, refs = task_lines_for(prompt, tasks, seen)
        out += lines
        shown += ids
        targets += refs
    found = incidents(cfg, repo_org(cfg, repo))
    if found:
        lines, ids = lines_for(prompt, found, seen)
        out += lines
        shown += ids
        # Lo que se imprimió, no lo recortado: eso no llegó a verlo.
        targets += [i for i in ids if any(i in line for line in lines)]
    if not out:
        return
    save_seen(session, seen | set(shown))
    print("\n".join(out))
    sys.stdout.flush()
    report_shown(cfg, "cac-prompt", targets)


if __name__ == "__main__":
    main()
